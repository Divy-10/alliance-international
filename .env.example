# ─────────────────────────────────────────────────────────────
# Alliance International — environment configuration
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Google Apps Script Web App URL (ends in /exec).
# Leave EMPTY to run the site on the local demo data in src/data/.
# Once set, all categories and products are read live from Google Sheets.
VITE_GOOGLE_APPS_SCRIPT_URL=

# Optional: send Contact form enquiries to the "Enquiries" sheet through the
# same Apps Script (doPost). Keep "false" until the script is deployed and tested.
# While false, the form validates and shows a clearly labelled demo message only.
VITE_ENABLE_ENQUIRY_SUBMISSION=false

# Optional: how long (seconds) fetched catalogue data is reused in the browser
# before being requested again. Lower = edits in Sheets appear sooner.
VITE_CACHE_SECONDS=60
